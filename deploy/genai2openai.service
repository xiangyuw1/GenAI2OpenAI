[Unit]
Description=GenAI2OpenAI Proxy Service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/GenAI2OpenAI
ExecStart=/opt/GenAI2OpenAI/.venv/bin/python main.py --token "YOUR_TOKEN_HERE" --port 5000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
